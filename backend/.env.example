# Django Settings
DJANGO_SECRET_KEY=your-secret-key-here
DEBUG=True
DJANGO_SETTINGS_MODULE=core.settings

# Database Configuration (PostgreSQL/Supabase)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=postgres
DB_USER=your-database-user
DB_PASSWORD=your-database-password
DB_HOST=your-database-host
DB_PORT=5432

# Email Configuration (Gmail SMTP)
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-specific-password

# Google Gemini AI API
GEMINI_API_KEY=your-gemini-api-key-here

# CORS Settings (Frontend URLs)
CORS_ORIGIN_1=http://localhost:5173
CORS_ORIGIN_2=http://localhost:5174
CORS_ORIGIN_3=https://cft-with-react.onrender.com
CORS_ORIGIN_4=https://cfthosting.vercel.app

# Allowed Hosts (comma-separated)
ALLOWED_HOSTS=localhost,127.0.0.1,cft-with-react.onrender.com

# Static Files
STATIC_URL=/static/
STATIC_ROOT=staticfiles

# Timezone
TIME_ZONE=Asia/Kolkata
